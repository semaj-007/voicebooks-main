{
  "name": "voicebooks-backend",
  "version": "1.0.0",
  "description": "Backend API for the VoiceBooks application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "firebase:emulators": "firebase emulators:start --only dataconnect --project demo-voicebooks --config ../firebase.json",
    "dev:firebase": "node scripts/dev-firebase.js",
    "test:firebase": "node scripts/test-firebase.js",
    "test:firebase:hosted": "node scripts/test-firebase.js --hosted"
  },
  "keywords": [
    "voicebooks",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@deepgram/sdk": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "firebase-tools": "^15.32.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
