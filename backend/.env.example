# Copy this file to .env and fill in the values.
PORT=3715
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Long random string (32+ chars). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_MINUTES=60

COOKIE_SECURE=false

BCRYPT_ROUNDS=12
RESET_TOKEN_TTL_MINUTES=30
DATABASE_FILE=./data/voicebooks.db

# sqlite (local existing data) or firebase (Firebase SQL Connect/PostgreSQL)
DATABASE_PROVIDER=sqlite
FIREBASE_PROJECT_ID=voicebooks-d7726
FIREBASE_SERVICE_ID=voicebooks-d7726-service
FIREBASE_LOCATION=us-east4
# Local testing only. Leave empty for hosted Firebase.
DATA_CONNECT_EMULATOR_HOST=
# For hosted local development, use Application Default Credentials or a private
# credential file outside this repository. Never commit service-account keys.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json

# ---- Email (password reset) ----
# Leave SMTP_HOST empty in development: the reset link is printed in the backend
# terminal and shown on the Forgot password screen instead of being emailed.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoiceBooks <no-reply@example.com>
