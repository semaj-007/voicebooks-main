# Copy this file to .env and fill in the values.
PORT=3715
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Long random string (32+ chars). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_MINUTES=60

COOKIE_SECURE=false

BCRYPT_ROUNDS=12
RESET_TOKEN_TTL_MINUTES=30
DATABASE_FILE=./data/voicebooks.db

# ---- Email (password reset) ----
# Leave SMTP_HOST empty in development: the reset link is printed in the backend
# terminal and shown on the Forgot password screen instead of being emailed.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoiceBooks <no-reply@example.com>

